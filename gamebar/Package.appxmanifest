<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
 xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
 xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
 xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3" IgnorableNamespaces="uap uap3 mp">
  <Identity Name="BlinkVerdict.GameBar" Publisher="CN=BlinkVerdict" Version="0.1.0.0" />
  <mp:PhoneIdentity PhoneProductId="c4d91352-d753-4d6c-b903-10b4de8fd600" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties><DisplayName>BlinkVerdict Game Bar</DisplayName><PublisherDisplayName>BlinkVerdict</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.19041.0" /></Dependencies>
  <Resources><Resource Language="zh-CN" /><Resource Language="en-US" /></Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="BlinkVerdict.GameBar.App">
      <uap:VisualElements DisplayName="BlinkVerdict Game Bar" Description="Experimental passive decision overlay"
       Square150x150Logo="Assets\Logo150.png" Square44x44Logo="Assets\Logo44.png" BackgroundColor="transparent">
        <uap:SplashScreen Image="Assets\Splash.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.appService"><uap:AppService Name="BlinkVerdictBridge" /></uap:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="microsoft.gameBarUIExtension" Id="Verdict" DisplayName="BlinkVerdict" Description="Passive AI decision overlay" PublicFolder="GameBar">
            <uap3:Properties><GameBarWidget Type="Standard">
              <HomeMenuVisible>true</HomeMenuVisible><PinningSupported>true</PinningSupported>
              <Window><Size><Width>320</Width><Height>140</Height><MinWidth>160</MinWidth><MinHeight>80</MinHeight><MaxWidth>7680</MaxWidth><MaxHeight>4320</MaxHeight></Size>
                <ResizeSupported><Horizontal>true</Horizontal><Vertical>true</Vertical></ResizeSupported>
              </Window>
            </GameBarWidget></uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Extensions>
    <Extension Category="windows.activatableClass.proxyStub"><ProxyStub ClassId="00000355-0000-0000-C000-000000000046">
